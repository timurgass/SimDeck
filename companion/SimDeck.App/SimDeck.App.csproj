<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><AssemblyName>SimDeck</AssemblyName><Version>0.9.11</Version><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/SimDeck.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup><Resource Include="Assets/SimDeck.ico"/></ItemGroup>
  <ItemGroup><ProjectReference Include="../SimDeck.Core/SimDeck.Core.csproj"/><FrameworkReference Include="Microsoft.AspNetCore.App"/><PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="F1Preset.json" LogicalName="SimDeck.F1Preset.json"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Browser/*" LogicalName="SimDeck.Browser.%(Filename)%(Extension)"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../assets/fs25-field-ui.json" LogicalName="SimDeck.Browser.fs25-field-ui.json"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../assets/f1-damage-zones.json" LogicalName="SimDeck.Browser.f1-damage-zones.json"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../assets/vehicles/*.png" LogicalName="SimDeck.Vehicle.%(Filename)%(Extension)"/></ItemGroup>
</Project>


