<ItemGroup><Content Include="../../third_party/ts-map/LICENSE" Link="third-party/ts-map-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="../../third_party/ts-map/libs/COPYING" Link="third-party/libdeflate-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup></Project>


