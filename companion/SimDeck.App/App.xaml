<Application x:Class="SimDeck.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#182026"/><SolidColorBrush x:Key="Accent" Color="#F2B84B"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8ECEE"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#27343B"/><Setter Property="Foreground" Value="#F2F5F7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0E151A"/><Setter Property="Foreground" Value="#E8ECEE"/><Setter Property="BorderBrush" Value="#3C4B53"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,10,5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8ECEE"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
</Application.Resources></Application>
