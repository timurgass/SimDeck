<Window x:Class="SimDeck.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SimDeck Companion" Icon="Assets/SimDeck.ico" Width="1440" Height="1000" MinWidth="1024" MinHeight="720" Background="#10171C" Foreground="#F3F5F7" FontFamily="Segoe UI" FontSize="14" Closing="WindowClosing">
  <Window.Resources>
    <Style x:Key="OptionalText" TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}" Value="0">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#192229" Offset="0" />
            <GradientStop Color="#131B20" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="23" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#AAB8C2" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="Padding" Value="16,17" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="GroupName" Value="Navigation" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#203B3B" />
                <Setter Property="Foreground" Value="#51E9CD" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#46E0C4" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EDF2F5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel>
              <Border x:Name="Track" DockPanel.Dock="Right" Width="48" Height="26" Background="#39474F" CornerRadius="13" Margin="15,0,0,0">
                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3" />
              </Border>
              <ContentPresenter VerticalAlignment="Center" />
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#46E0C4" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="White" />
                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Border BorderBrush="#29353D" BorderThickness="0,0,1,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1A242B" Offset="0" />
          <GradientStop Color="#11191E" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel Margin="14,24,14,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="40" Height="40" Margin="0,0,8,0">
              <Canvas Width="108" Height="108">
                <Path Fill="#0B1115" Data="M0,0H108V108H0Z" />
                <Path Fill="#F2B84B" Data="M26,28H82V39H39V49H72V80H26V69H59V59H26Z" />
                <Path Fill="#E8ECEE" Data="M78,49H83V59H78Z" />
              </Canvas>
            </Viewbox>
            <StackPanel>
              <TextBlock Text="SIMDECK" FontSize="23" FontWeight="Bold" />
              <TextBlock Text="COMPANION" Foreground="{StaticResource Muted}" FontSize="11" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="11" />
          <TextBlock Text="Ваш пульт. В одно касание." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel>
          <RadioButton x:Name="OverviewNav" Style="{StaticResource Nav}" Tag="overview" Checked="Navigate" Content="⌂    Обзор" />
          <RadioButton x:Name="DevicesNav" Style="{StaticResource Nav}" Tag="devices" Checked="Navigate" Content="▯    Устройства" />
          <RadioButton x:Name="ProfilesNav" Style="{StaticResource Nav}" Tag="profiles" Checked="Navigate" Content="▱    Профили" />
          <RadioButton x:Name="DiagnosticsNav" Style="{StaticResource Nav}" Tag="diagnostics" Checked="Navigate" Content="⌁    Диагностика" />
          <RadioButton x:Name="SettingsNav" Style="{StaticResource Nav}" Tag="settings" Checked="Navigate" Content="⚙    Настройки" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24,20,24,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <Border DockPanel.Dock="Right" Background="#1B3730" BorderBrush="#31584A" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="12,0,0,0">
          <TextBlock x:Name="GameStatus" Text="○  Ожидание игры" Foreground="#7FDBC4" VerticalAlignment="Center" />
        </Border>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ComboBox x:Name="ProfilePicker" SelectedValuePath="Id" Width="185" VerticalContentAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Открыть" Click="ChangeProfile" Margin="8,0,0,0" ToolTip="Применить выбранный игровой профиль" />
        </StackPanel>
        <TextBlock x:Name="SectionTitle" Text="Обзор" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Grid x:Name="OverviewGrid" Margin="0,0,0,16" SizeChanged="LayoutChanged">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="ConnectionColumn" Width="1.4*" />
              <ColumnDefinition x:Name="GapColumn" Width="16" />
              <ColumnDefinition x:Name="MetricsColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ConnectionCard" Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="WifiButton" Content="Wi-Fi" Click="ChooseWifi" Margin="0,0,4,0" Padding="18,7" />
                    <Button x:Name="UsbButton" Content="USB" Click="ChooseUsb" Margin="0" Padding="18,7" />
                  </StackPanel>
                  <TextBlock Text="Подключение" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                </DockPanel>
                <Viewbox Height="110" Margin="15,18,15,10" Stretch="Uniform">
                  <Canvas Width="490" Height="130">
                    <Rectangle Canvas.Left="12" Canvas.Top="12" Width="140" Height="94" RadiusX="5" RadiusY="5" Stroke="#667985" StrokeThickness="4" Fill="#10181D" />
                    <Path Data="M0,114 L164,114 M46,48 L75,44 75,70 46,70 Z M81,43 L113,39 113,70 81,70 Z M46,76 L75,76 75,102 46,97 Z M81,76 L113,76 113,108 81,103 Z" Stroke="#667985" StrokeThickness="3" />
                    <Path Data="M170,69 L216,69 C238,69 236,92 257,92 L280,92 C301,92 300,69 323,69 L347,69" Stroke="#46E0C4" StrokeThickness="4" />
                    <Rectangle Canvas.Left="357" Canvas.Top="20" Width="120" Height="91" RadiusX="6" RadiusY="6" Stroke="#667985" StrokeThickness="5" Fill="#10181D" />
                    <TextBlock Canvas.Left="392" Canvas.Top="40" Text="S" FontSize="42" FontWeight="Bold" Foreground="#46E0C4" />
                  </Canvas>
                </Viewbox>
                <TextBlock x:Name="DeviceLabel" Text="Планшет не подключён" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="TransportLabel" Text="Выберите Wi-Fi или USB" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,9,0,12" TextWrapping="Wrap" />
                <Button x:Name="PairButton" Style="{StaticResource Primary}" Content="↗   Подключить устройство" Click="OpenPairing" IsEnabled="False" HorizontalAlignment="Center" Width="310" Margin="0,4" />
                <TextBlock x:Name="PairCode" Style="{StaticResource OptionalText}" FontSize="28" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                <Button Content="◉   Открыть Safari" Click="OpenBrowser" HorizontalAlignment="Center" Width="310" Margin="0,6,0,0" />
                <TextBlock x:Name="BrowserAddress" Style="{StaticResource OptionalText}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,6,0,0" />
                <TextBlock x:Name="BrowserCode" Style="{StaticResource OptionalText}" FontSize="23" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="TransportHelp" Style="{StaticResource OptionalText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <Expander x:Name="ConnectionDetails" Header="Адрес, отпечаток и доступ" Foreground="{StaticResource Muted}" Margin="0,12,0,0">
                  <StackPanel Margin="0,10,0,0">
                    <TextBlock x:Name="ConnectionStatus" Text="Запуск…" TextWrapping="Wrap" />
                    <TextBlock Text="На Android сравните отпечаток ПК перед вводом кода." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8" />
                    <TextBox x:Name="FingerprintText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                    <TextBlock x:Name="AddressText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6" />
                    <Button Content="Отозвать доступ устройств" Click="Revoke" />
                    <TextBlock Text="Safari: локальная домашняя сеть, HTTP без шифрования. Доступ до закрытия Companion, максимум 8 часов." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <StackPanel x:Name="MetricsCards" Grid.Column="2">
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Телеметрия" Style="{StaticResource Heading}" />
                  <TextBlock x:Name="SourceLabel" Text="Ожидание данных игры" Foreground="{StaticResource Muted}" Margin="0,8,0,14" TextWrapping="Wrap" />
                  <UniformGrid Columns="3">
                    <StackPanel>
                      <TextBlock x:Name="SpeedLabel" Text="—" FontSize="34" FontWeight="SemiBold" />
                      <TextBlock Text="км/ч" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock x:Name="RpmLabel" Text="—" FontSize="34" FontWeight="SemiBold" />
                      <TextBlock Text="RPM" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock x:Name="GearLabel" Text="—" FontSize="34" FontWeight="SemiBold" />
                      <TextBlock Text="Передача" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                  </UniformGrid>
                  <TextBlock x:Name="TelemetryAge" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Управление" Style="{StaticResource Heading}" />
                  <CheckBox x:Name="EnableInput" Style="{StaticResource Toggle}" Content="Разрешить ввод" Checked="InputChanged" Unchecked="InputChanged" Margin="0,14,0,6" />
                  <Separator Background="{StaticResource Line}" />
                  <CheckBox x:Name="CompatibleInput" Content="Совместимый ввод" Checked="InputModeChanged" Unchecked="InputModeChanged" ToolTip="Virtual-Key: включите, если игра не реагирует на Scan Code" />
                  <TextBlock x:Name="InputStatus" Text="Выключено" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />
                  <Separator Background="{StaticResource Line}" />
                  <TextBlock Text="Последняя команда" Foreground="{StaticResource Muted}" Margin="0,8,0,4" />
                  <TextBlock x:Name="LastCommand" Text="Команд пока нет" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Border x:Name="EditorCard" Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Grid Width="170" Margin="0,4,10,4">
                    <TextBox x:Name="ActionSearch" TextChanged="SearchChanged" ToolTip="Поиск по названию, разделу, клавише и описанию" AutomationProperties.Name="Поиск действия" />
                    <TextBlock Text="Поиск действия" Foreground="{StaticResource Muted}" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=ActionSearch}" Value="">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                  <Button Content="+  Добавить" Style="{StaticResource Primary}" Click="AddButton" />
                  <Button Content="Сохранить" Click="SaveBindings" Margin="0,4" />
                </StackPanel>
                <TextBlock Text="Кнопки профиля" Style="{StaticResource Heading}" VerticalAlignment="Center" />
              </DockPanel>
              <DataGrid x:Name="ButtonGrid" Height="200" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single" Background="#121A20" Foreground="#EDF2F5" RowBackground="#151F25" AlternatingRowBackground="#19252B" BorderBrush="{StaticResource Line}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#314049" HeadersVisibility="Column" RowHeaderWidth="0">
                <DataGrid.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#EDF2F5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="10,6" />
                  </Style>
                  <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="#C4D0D8" />
                    <Setter Property="Background" Value="#25323A" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="10,11" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                  <Style TargetType="DataGridRow">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="FontSize" Value="14" />
                  </Style>
                  <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#28544F" />
                        <Setter Property="Foreground" Value="White" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                  <Style x:Key="GestureEditor" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
                  <Style x:Key="GestureDisplay" TargetType="ComboBox" BasedOn="{StaticResource GestureEditor}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                          <TextBlock Text="{TemplateBinding SelectedItem}" Foreground="#EDF2F5" Margin="10,6" VerticalAlignment="Center" />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Действие" Binding="{Binding Label}" Width="2*" MinWidth="175" />
                  <DataGridTextColumn Header="Страница" Binding="{Binding Page}" Width="*" MinWidth="115" />
                  <DataGridTextColumn Header="Вкладка" Binding="{Binding Group}" Width="*" MinWidth="95" />
                  <DataGridTextColumn Header="Клавиша" Binding="{Binding Key}" Width="*" MinWidth="100" />
                  <DataGridComboBoxColumn x:Name="GestureColumn" Header="Тип" SelectedItemBinding="{Binding GestureLabel}" Width="*" MinWidth="150" ElementStyle="{StaticResource GestureDisplay}" EditingElementStyle="{StaticResource GestureEditor}" />
                  <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="1.5*" MinWidth="170" />
                </DataGrid.Columns>
              </DataGrid>
              <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="ActionCount" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <WrapPanel>
                  <Button Content="Удалить" Click="DeleteButton" />
                  <Button Content="↑" Click="MoveUp" ToolTip="Переместить выбранное действие вверх" />
                  <Button Content="↓" Click="MoveDown" ToolTip="Переместить выбранное действие вниз" />
                  <Button x:Name="ImportSnowRunnerButton" Content="Прочитать клавиши SnowRunner" Click="ImportSnowRunnerBindings" Visibility="Collapsed" />
                  <Button x:Name="ImportFs25Button" Content="Прочитать клавиши FS25" Click="ImportFs25Bindings" Visibility="Collapsed" />
                  <Button x:Name="LoadFs25PlanButton" Content="Загрузить план FS25" Click="LoadFs25Plan" Visibility="Collapsed" />
                </WrapPanel>
              </DockPanel>
              <Expander x:Name="ProfileDetails" Visibility="Collapsed" Header="Назначения и помощь" Foreground="{StaticResource Muted}" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock x:Name="ProfileHelp" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10" />
                  <TextBlock Text="Двойной щелчок по ячейке — изменить. Сочетания: Ctrl+Q, Alt+Shift+N. Сохранение обновит планшет." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border x:Name="DiagnosticCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Данные игры и доставка команд" Style="{StaticResource Heading}" />
              <TextBlock x:Name="DiagnosticSummary" Margin="0,16" TextWrapping="Wrap" />
              <TextBlock x:Name="TelemetryHelp" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
              <TextBlock Text="Возраст кадра — время с момента получения данных игры. Это не задержка сети. Клавиатурный ввод и телеметрия работают независимо." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,20,0,0" />
            </StackPanel>
          </Border>
          <Border x:Name="SettingsCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Настройки профиля" Style="{StaticResource Heading}" />
              <TextBlock Text="Процесс игры без .exe" Foreground="{StaticResource Muted}" Margin="0,20,0,8" />
              <TextBox x:Name="ProcessName" MaxWidth="440" HorizontalAlignment="Left" MinWidth="300" />
              <Button Content="Сохранить настройки и кнопки" Click="SaveBindings" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12" />
              <CheckBox x:Name="DemoBox" Content="Демонстрация · игровой ввод отключён" Checked="SourceChanged" Unchecked="SourceChanged" />
              <TextBlock Text="Разрешение ввода и совместимый режим находятся на странице «Обзор». Ввод действует только в активном окне выбранной игры." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock x:Name="ErrorLabel" Grid.Row="2" Foreground="#FFD18A" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
  </Grid>
</Window>
